<% if (totalPages > 1) { %>
    <nav class="d-flex align-items-center flex-wrap gap-3 mt-4" aria-label="Страницы">
        <% if (page > 1) { %><a href="<%= linkTo(page - 1) %>" class="btn btn-outline-primary">Назад</a><% } %>
        <span>Страница <%= page %> из <%= totalPages %></span>
        <% if (page < totalPages) { %><a href="<%= linkTo(page + 1) %>" class="btn btn-outline-primary">Вперёд</a><% } %>
    </nav>
<% } %>
