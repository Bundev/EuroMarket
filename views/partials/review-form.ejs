<% if (deal.review_rating) { %>
    <p class="mt-3 mb-1">Ваша оценка: <%= deal.review_rating %> из 5.
        <% if (deal.review_hidden_at) { %>Отзыв скрыт модератором.<% } %>
    </p>
<% } %>
<% if (!deal.review_rating || deal.review_editable) { %>
    <details class="mt-2">
        <summary class="text-primary"><%= deal.review_rating ? 'Редактировать отзыв' : 'Оставить отзыв' %></summary>
        <form action="/my-purchases/<%= deal.id %>/review" method="post" class="mt-2">
            <input type="hidden" name="_csrf" value="<%= favoritesCsrfToken %>">
            <input type="hidden" name="mode" value="<%= deal.review_rating ? 'edit' : 'create' %>">
            <label class="form-label" for="review-rating-<%= deal.id %>">Оценка</label>
            <select class="form-select mb-2" name="rating" id="review-rating-<%= deal.id %>" required>
                <option value="">Выберите оценку</option>
                <% for (let stars = 5; stars >= 1; stars--) { %>
                    <option value="<%= stars %>" <%= Number(deal.review_rating) === stars ? 'selected' : '' %>><%= stars %> из 5</option>
                <% } %>
            </select>
            <label class="form-label" for="review-comment-<%= deal.id %>">Комментарий (необязательно)</label>
            <textarea class="form-control mb-2" rows="3" name="comment" maxlength="1500" id="review-comment-<%= deal.id %>"><%= deal.review_comment || '' %></textarea>
            <p class="form-text">Отзыв публичный. Его можно отредактировать в течение 7 дней.</p>
            <button class="btn btn-primary">Сохранить отзыв</button>
        </form>
    </details>
<% } %>
