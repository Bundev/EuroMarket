<dl class="seller-metrics <%= summary ? 'seller-metrics-summary' : '' %>" aria-label="<%= summary ? 'Сводка продавца' : 'Статистика объявления' %>">
    <% for (const [label, value, color, path] of [
        ['Просмотры', metrics.views, 'views', 'M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12Zm13 0a3 3 0 1 0-6 0 3 3 0 0 0 6 0Z'],
        ['Избранное', metrics.favorites, 'favorites', 'M12 20 4 12a5 5 0 0 1 8-6 5 5 0 0 1 8 6Z'],
        ['Диалоги', metrics.contacts, 'contacts', 'M4 4h16v12H9l-5 4V4Z']
    ]) { %>
        <div class="seller-metric seller-metric-<%= color %>">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><path d="<%= path %>"/></svg>
            <dt class="seller-metric-label"><%= label %></dt>
            <dd class="seller-metric-value"><%= value ?? 0 %></dd>
        </div>
    <% } %>
</dl>
