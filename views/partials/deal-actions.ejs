<% if (actions.length) { %>
    <div class="d-flex flex-wrap gap-2">
        <% for (const [action, label] of actions) { %>
            <form method="post" action="/deals/<%= deal.id %>">
                <input type="hidden" name="_csrf" value="<%= favoritesCsrfToken %>">
                <button class="btn <%= ['accept', 'confirm'].includes(action) ? 'btn-primary' : 'btn-outline-secondary' %>"
                        type="submit" name="action" value="<%= action %>"><%= label %></button>
            </form>
        <% } %>
    </div>
<% } %>
