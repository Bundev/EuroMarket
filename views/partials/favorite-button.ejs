<button type="button"
        class="search-listing-favorite favorite-button <%= typeof extraClass === 'string' ? extraClass : '' %>"
        data-favorite-id="<%= listing.id %>"
        aria-pressed="<%= favoriteIds.has(Number(listing.id)) ? 'true' : 'false' %>"
        aria-label="<%= favoriteIds.has(Number(listing.id)) ? 'Удалить из избранного' : 'Добавить в избранное' %>"
        title="<%= favoriteIds.has(Number(listing.id)) ? 'Удалить из избранного' : 'Добавить в избранное' %>">
    <svg width="25" height="25" viewBox="0 0 24 24" fill="none" stroke="currentColor"
         stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
    </svg>
</button>
