<header class="site-header">
    <nav class="container header-row" aria-label="Основная навигация">
        <a class="header-brand" href="/" aria-label="EuroMarket — главная">EuroMarket</a>
        <form action="/search" method="GET" role="search" class="header-search">
            <label for="headerSearch" class="visually-hidden">Поиск объявлений</label>
            <input type="search" id="headerSearch" name="search" class="form-control"
                   placeholder="Что вы ищете?" maxlength="100" value="<%= headerSearchQuery %>">
            <input type="hidden" name="country_id" value="<%= selectedCountryInfo ? selectedCountryInfo.id : '' %>">
            <button type="submit" class="btn btn-primary" aria-label="Найти объявления" title="Найти">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" aria-hidden="true">
                    <circle cx="11" cy="11" r="7"/><path d="m16 16 4 4"/>
                </svg>
            </button>
        </form>
        <a class="header-icon header-favorites" href="/favorites" aria-label="Избранное" title="Избранное">
            <svg width="23" height="23" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0l-1 1-1-1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8Z"/>
            </svg>
        </a>

        <details class="header-notifications">
            <summary class="header-icon" aria-label="Уведомления" title="Уведомления">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                    <path d="M5 17h14l-2-3V9a5 5 0 0 0-10 0v5l-2 3ZM10 21h4"/>
                </svg>
                <span class="message-badge" data-notification-count <%- unreadNotifications ? '' : 'hidden' %>><%= unreadNotifications > 99 ? '99+' : unreadNotifications %></span>
            </summary>
            <div class="notification-dropdown">
                <div class="d-flex justify-content-between gap-2 mb-2">
                    <strong>Уведомления</strong><a href="/notifications">Все</a>
                </div>
                <p data-notification-error role="status"></p>
                <div data-notification-latest></div>
                <% if (user) { %><button type="button" class="btn btn-outline-primary w-100 mt-2" data-notification-read-all>Отметить все как прочитанные</button><% } %>
                <noscript><a href="/notifications">Открыть уведомления</a></noscript>
            </div>
        </details>
        <button class="header-icon header-toggle" type="button" aria-controls="headerPanel" aria-expanded="false" aria-label="Открыть меню">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                <path d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
        </button>
        <div class="header-panel" id="headerPanel" hidden>

            <form action="<%= typeof headerCountryAction === 'string' ? headerCountryAction : '/' %>" method="GET" class="header-country">
                <% if (typeof headerCountrySort === 'string' && headerCountrySort) { %>
                    <input type="hidden" name="sort" value="<%= headerCountrySort %>">
                <% } %>
                <label class="header-country-label" for="headerCountry">Страна объявлений</label>
                <select name="country" id="headerCountry" class="form-select header-country-select">
                    <option value="all" <%= selectedCountry === 'all' ? 'selected' : '' %>>Все страны</option>
                    <% countries.forEach(country => { %>
                        <option value="<%= country.code %>" <%= selectedCountry === country.code ? 'selected' : '' %>><%= country.name %></option>
                    <% }) %>
                </select>
                <noscript><button type="submit" class="btn btn-outline-primary mt-2">Выбрать</button></noscript>
            </form>
        <a class="header-icon header-messages" href="/messages" aria-label="Сообщения" title="Сообщения" <%- user ? 'data-poll-messages' : '' %>>
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path d="M4 4h16v12H8l-4 4V4Z"/><path d="M8 8h8M8 12h5"/>
            </svg>
            <span class="header-messages-label">Сообщения</span>
            <span class="message-badge" data-message-unread <%- unreadMessages ? '' : 'hidden' %>><%= unreadMessages > 99 ? '99+' : unreadMessages %></span>
        </a>
            <% if (user) { %>
                <details class="header-account">
                    <summary class="header-user" title="<%= user.name %>">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                            <circle cx="12" cy="8" r="4"/><path d="M4 21v-2a8 8 0 0 1 16 0v2"/>
                        </svg>
                        <span class="header-user-name"><%= user.name %></span>
                        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m4 6 4 4 4-4"/></svg>
                    </summary>
                    <div class="header-user-menu">
                        <a href="/profile">Мой профиль</a>
                        <% if (user.role === 'admin') { %><a href="/admin">Администрирование</a><% } %>
                        <a href="/my-listings">Мои объявления</a>
                        <a href="/my-purchases">Мои покупки</a>
                        <a href="/favorites">Избранное</a>
                        <a href="/messages">Сообщения</a>
                        <a href="/notifications">Уведомления</a>
                        <form action="/logout" method="POST">
        <input type="hidden" name="_csrf" value="<%= favoritesCsrfToken %>">
                            <button type="submit" class="header-logout">Выйти</button>
                        </form>
                    </div>
                </details>
            <% } else { %>
                <div class="header-account header-guest">
                    <a href="/login">Войти</a>
                    <a href="/register">Регистрация</a>
                </div>
            <% } %>
            <a class="btn btn-primary header-publish" href="/listings/create">+ Подать объявление</a>
        </div>
    </nav>
</header>
<script src="/js/header.js" defer></script>
<script src="/js/message-counter.js" defer></script>
<script src="/js/notifications.js" defer></script>
