
<meta charset="UTF-8">

<meta name="viewport"
      content="width=device-width, initial-scale=1">

<% const pageSeo = typeof seo !== 'undefined' ? seo : null; %>
<title><%= pageSeo?.title || (typeof pageTitle !== 'undefined' ? pageTitle + ' — EuroMarket' : 'EuroMarket') %></title>
<% if (pageSeo) { %>
    <meta name="description" content="<%= pageSeo.description %>">
    <% if (pageSeo.indexable) { %>
        <link rel="canonical" href="<%= pageSeo.canonical %>">
        <meta property="og:type" content="website">
        <meta property="og:site_name" content="EuroMarket">
        <meta property="og:locale" content="<%= pageSeo.socialLocale %>">
        <meta property="og:title" content="<%= pageSeo.title %>">
        <meta property="og:description" content="<%= pageSeo.description %>">
        <meta property="og:url" content="<%= pageSeo.canonical %>">
        <meta name="twitter:card" content="<%= pageSeo.image ? 'summary_large_image' : 'summary' %>">
        <meta name="twitter:title" content="<%= pageSeo.title %>">
        <meta name="twitter:description" content="<%= pageSeo.description %>">
        <% if (pageSeo.image) { %>
            <meta property="og:image" content="<%= pageSeo.image %>">
            <meta name="twitter:image" content="<%= pageSeo.image %>">
        <% } %>
        <% if (pageSeo.json) { %><script type="application/ld+json"><%- pageSeo.json %></script><% } %>
    <% } %>
<% } %>

<link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet">

<link rel="stylesheet" href="/css/main.css">
<meta name="favorites-csrf-token" content="<%= favoritesCsrfToken %>">
<script src="/js/toasts.js" defer></script>
<script src="/js/favorites.js" defer></script>
<script src="/js/compare.js" defer></script>
<script src="/js/form-confirm.js" defer></script>
