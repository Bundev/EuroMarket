<!DOCTYPE html>
<html lang="ru">
<head>
   <%- include('../partials/head', { pageTitle: 'Подать объявление' }) %>
   <link
    href="https://cdn.jsdelivr.net/npm/tom-select@2.4.3/dist/css/tom-select.bootstrap5.min.css"
    rel="stylesheet"
>
</head>
<body class="bg-light">
<%- include('../partials/toasts') %>

<%- include('../partials/header') %>

<main class="container py-4">

    <div class="row justify-content-center">
        <div class="col-lg-12 col-xl-10">

            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="mb-0">Подать объявление</h2>
                <a href="/my-listings" class="btn btn-outline-secondary">
                    Назад
                </a>
            </div>

            <% if (error) { %>
                <div class="alert alert-danger">
                    <%= error %>
                </div>
            <% } %>

            <div class="card shadow-sm border-0">
                <div class="card-body p-4">

                    <form action="/listings" method="POST" enctype="multipart/form-data" data-listing-upload>
                            <noscript><p class="text-danger">Для безопасной отправки этой формы включите JavaScript.</p></noscript>
                        
                        <!-- Загрузка фотографий -->
                        <div class="listing-upload-form mb-4" id="createUpload">

                            <h5 class="mb-3">Фотографии объявления</h5>

                            <div
                                class="listing-upload-zone"
                                id="createUploadZone"
                                role="button"
                                tabindex="0"
                                aria-label="Выбрать фотографии"
                            >
                                <div class="listing-upload-icon">
                                    <svg width="32" height="32"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="1.8"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        aria-hidden="true">
                                        <path d="M12 16V4"/>
                                        <path d="m7 9 5-5 5 5"/>
                                        <path d="M20 16.6A5 5 0 0 0 18 7a6 6 0 0 0-11.5 1.5A4.5 4.5 0 0 0 7 17h2"/>
                                    </svg>
                                </div>

                                <div class="fw-semibold mt-3">
                                    Перетащите фотографии сюда
                                </div>

                                <div class="text-muted small mt-1">
                                    или нажмите, чтобы выбрать файлы
                                </div>

                                <div class="listing-upload-hint mt-3">
                                    JPG, PNG, WebP · до 5 МБ
                                </div>
                            </div>

                            <input
                                type="file"
                                id="createListingImages"
                                name="images"
                                accept="image/jpeg,image/png,image/webp"
                                multiple
                                class="visually-hidden"
                                tabindex="-1"
                            >

                            <div id="createImagesPreview"
                                class="row g-2 mt-2"></div>

                            <div class="d-flex justify-content-between
                                        align-items-center mt-3">
                                <small class="text-muted">
                                    Максимум 10 фотографий
                                </small>

                                <small class="text-muted" id="createUploadCount">
                                    0 выбрано
                                </small>
                            </div>

                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">
                                Название объявления
                            </label>
                            <input
                                type="text"
                                name="title"
                                class="form-control"
                                maxlength="200"
                                placeholder="Например: iPhone 15 Pro"
                                required>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">
                                Категория
                            </label>
                            <select name="category_id"
                                    class="form-select"
                                    required>
                                <option value="">Выберите категорию</option>
                                <% categories.forEach(category => { %>
                                    <option value="<%= category.id %>">
                                        <%= category.name %>
                                    </option>
                                <% }) %>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">
                                Страна
                            </label>
                            <select name="country_id" id="countrySelect"
                                    class="form-select"
                                    required>
                                <option value="">Выберите страну</option>
                                <% countries.forEach(country => { %>
                                    <option value="<%= country.id %>" data-currency="<%= country.currency %>">
                                        <%= country.name %>
                                    </option>
                                <% }) %>
                            </select>
                        </div>

<div class="mb-3">
    <label for="citySelect" class="form-label">
        Город
    </label>

    <select
        name="city_id"
        id="citySelect"
        class="form-select"
        disabled
    >
        <option value="">Сначала выберите страну</option>
    </select>

    <div class="form-text">
        Выберите город, где находится товар.
    </div>
</div>


                        <div class="mb-3">
                            <label class="form-label fw-semibold">
                                Цена <span id="priceCurrency"></span>
                            </label>
                            <input
                                type="number"
                                name="price"
                                class="form-control"
                                min="0"
                                max="9999999999.99"
                                step="0.01"
                                placeholder="Например: 500"
                                required>
                            <div class="form-text">
                                Валюта определяется выбранной страной.
                                При смене страны проверьте и при необходимости измените цену. Сумма автоматически не пересчитывается.
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold">
                                Описание
                            </label>
                            <textarea
                                name="description"
                                class="form-control"
                                rows="6"
                                placeholder="Опишите товар, его состояние и особенности"
                                required></textarea>
                        </div>


                        
                                                
                        

                        <button type="submit"
                                class="btn btn-primary">
                            Сохранить объявление
                        </button>
                    </form>

                </div>
            </div>

        </div>
    </div>

</main>

<script src="/js/listing-create-photos.js"></script>

<script src="https://cdn.jsdelivr.net/npm/tom-select@2.4.3/dist/js/tom-select.complete.min.js"></script>
<script src="/js/listing-create-location.js"></script>


<script src="/js/listing-upload.js" defer></script>
</body>
</html>
