<!DOCTYPE html>
<html lang="<%= typeof contentLocale === 'undefined' ? 'ru' : contentLocale.language %>">
<head>
    <%- include('../partials/head', { pageTitle: 'Главная' }) %>
</head>
<body>
<%- include('../partials/toasts') %>
<%- include('../partials/header') %>

<section class="hero">
    <div class="container">
        <h1 class="fw-bold">Покупай и продавай в Европе</h1>

        <p class="text-secondary">
            Миллионы возможностей рядом с тобой
        </p>
    </div>
</section>

<section class="container py-5">
    <h2 class="fw-bold mb-4">Категории объявлений</h2>

    <div class="row g-3">

        

        <div class="row g-3">
                <% categories.forEach(category => { %>
                    <div class="col-6 col-md-3">
                        <a href="<%= categoryLink(category.slug) %>"
                        class="card text-decoration-none h-100">

                            <div class="card-body text-center">
                                <div class="fs-1 mb-2">
                                    <%= category.icon %>
                                </div>

                                <h5 class="card-title">
                                    <%= category.name %>
                                </h5>
                            </div>

                        </a>
                    </div>
                <% }) %>
            </div>

    </div>
</section>

<section class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold mb-0">Свежие объявления</h3>
    </div>

    <% if (listings.length > 0) { %>
        <div class="row g-4">
            <% listings.forEach(listing => { %>
                <div class="col-6 col-md-4 col-lg-3 position-relative">
                    <%- include('../partials/marketplace-card', { listing }) %>
                </div>
            <% }) %>
        </div>
    <% } else { %>
        <p class="text-muted"><%= selectedCountryInfo
            ? 'В стране «' + selectedCountryInfo.name + '» пока нет опубликованных объявлений.'
            : 'Пока нет опубликованных объявлений.' %></p>
    <% } %>
</section>

<%- include('../partials/listing-strip', { listings: recommended, heading: 'Вам может понравиться', headingId: 'recommendations-title', more: '/recommendations' }) %>
<%- include('../partials/recent-listings', { listings: typeof recentListings === 'undefined' ? [] : recentListings }) %>

<footer class="bg-white border-top py-4">
    <div class="container text-center text-secondary">
        © 2026 EuroMarket — European Marketplace
    </div>
</footer>

</body>
</html>
