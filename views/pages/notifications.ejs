<!DOCTYPE html>
<html lang="ru">
<head><%- include('../partials/head', { pageTitle: 'Уведомления' }) %></head>
<body>
<%- include('../partials/toasts') %>
<%- include('../partials/header') %>
<main class="container py-4" data-notifications-page>
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <h1 class="h3 mb-0">Уведомления</h1>
        <button type="button" class="btn btn-outline-primary" data-notification-read-all>Отметить все как прочитанные</button>
    </div>
    <p data-notification-error role="status"></p>
    <% if (!items.length) { %><p class="text-muted">Уведомлений пока нет.</p><% } %>
    <div class="list-group">
        <% items.forEach(item => { %>
            <article class="list-group-item notification-item <%= item.read_at ? '' : 'notification-unread' %>" data-notification-id="<%= item.id %>">
                <a href="/notifications/<%= item.id %>/open" data-notification-open="<%= item.id %>"><%= item.text %></a>
                <div class="small text-muted"><%= new Date(item.created_at).toLocaleString('ru-RU') %></div>
                <% if (!item.read_at) { %><button type="button" class="btn btn-sm btn-link" data-notification-read="<%= item.id %>">Отметить прочитанным</button><% } %>
            </article>
        <% }) %>
    </div>
    <nav class="d-flex justify-content-between mt-3" aria-label="Страницы уведомлений">
        <% if (page > 1) { %><a href="/notifications?page=<%= page - 1 %>">Назад</a><% } %>
        <% if (page < pages) { %><a href="/notifications?page=<%= page + 1 %>">Вперёд</a><% } %>
    </nav>
</main>
</body>
</html>
