<!DOCTYPE html>
<html lang="<%= typeof contentLocale === 'undefined' ? 'ru' : contentLocale.language %>">
<head>
    <%- include('../partials/head', { pageTitle: 'Профиль продавца' }) %>
    <script src="/js/listing-view.js"></script>
    <script src="/js/follow.js" defer></script>
</head>
<body>
<%- include('../partials/toasts') %>
<%- include('../partials/header') %>
<main class="container py-4">
    <section class="card card-body mb-4" aria-labelledby="seller-name">
        <div class="d-flex align-items-start gap-3">
            <div class="seller-avatar" aria-hidden="true"><%= seller.name.charAt(0).toUpperCase() %></div>
            <div class="text-break">
                <h1 class="h3 mb-1" id="seller-name"><%= seller.name %></h1>
                <%- include('../partials/verified-phone', { verified: seller.phone_verified }) %>
                <% if (!seller.phone_verified) { %><p class="small text-muted mb-1">Телефон не подтверждён</p><% } %>
                <p class="text-muted mb-2">На EuroMarket с <%= seller.created_at.toLocaleDateString('ru-RU') %></p>
                <div class="seller-rating-row">
                    <%- include('../partials/seller-rating', { rating }) %>
                    <a href="<%= reviewsPath %>">Все отзывы</a>
                </div>
                <p class="text-muted small mt-2 mb-0">Подписчиков: <span data-follower-count aria-live="polite"><%= follow.total %></span></p>
                <p class="small text-muted mb-0">Завершённых сделок: <%= seller.completed_deals %></p>
                <% if (!user || Number(user.id) !== Number(seller.id)) { %>
                    <div class="mt-3">
                        <% if (user) { %>
                            <%- include('../partials/follow-button', { sellerId: seller.id, following: follow.following }) %>
                        <% } else { %>
                            <a href="/login" class="btn btn-outline-primary">Войти, чтобы подписаться</a>
                        <% } %>
                    </div>
                <% } %>
            </div>
        </div>
        <% if (user && Number(user.id) !== Number(seller.id)) { %>
            <details class="mt-3">
                <summary>Пожаловаться на продавца</summary>
                <form action="/users/<%= seller.id %>/report" method="post" class="mt-2">
                    <input type="hidden" name="_csrf" value="<%= favoritesCsrfToken %>">
                    <label class="form-label" for="seller-report-reason">Причина</label>
                    <select id="seller-report-reason" class="form-select mb-2" name="reason" required>
                        <% for (const [value, label] of Object.entries(reportReasons)) { %><option value="<%= value %>"><%= label %></option><% } %>
                    </select>
                    <label class="form-label" for="seller-report-comment">Комментарий</label>
                    <textarea id="seller-report-comment" class="form-control mb-2" name="comment" maxlength="1000" rows="3"></textarea>
                    <button class="btn btn-outline-danger">Отправить жалобу</button>
                </form>
            </details>
        <% } else if (!user) { %><a class="mt-3" href="/login">Войти, чтобы пожаловаться на продавца</a><% } %>
    </section>

    <section aria-labelledby="seller-listings">
        <div class="d-flex flex-wrap gap-3 align-items-center justify-content-between mb-3">
            <h2 class="h5 mb-0" id="seller-listings">Активные объявления <span class="text-muted">(<%= total %>)</span></h2>
            <% if (listings.length) { %><%- include('../partials/listing-view-toggle') %><% } %>
        </div>
        <% if (listings.length) { %>
            <form action="<%= profilePath %>" method="get" class="d-flex flex-wrap align-items-end gap-2 mb-3">
                <div>
                    <label class="form-label" for="seller-sort">Сортировка</label>
                    <select name="sort" id="seller-sort" class="form-select">
                        <% for (const [value, label] of Object.entries(sorts)) { %>
                            <option value="<%= value %>" <%= value === sort ? 'selected' : '' %>><%= label %></option>
                        <% } %>
                    </select>
                </div>
                <button type="submit" class="btn btn-outline-primary">Применить</button>
            </form>
            <% if (sort !== 'newest') { %><p class="text-muted small">Цены сортируются внутри каждой валюты.</p><% } %>
            <div class="search-results-list">
                <% for (const listing of listings) { %>
                    <%- include('../partials/search-listing-card', { listing }) %>
                <% } %>
            </div>
            <%- include('../partials/account-pagination', { page, totalPages, linkTo }) %>
        <% } else { %>
            <p class="card card-body">У продавца пока нет активных объявлений.</p>
        <% } %>
    </section>
</main>
</body>
</html>
