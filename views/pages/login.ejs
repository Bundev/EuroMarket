
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, initial-scale=1">

    <title>Вход — EuroMarket</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet">
<link rel="stylesheet" href="/css/main.css">
<meta name="favorites-csrf-token" content="<%= favoritesCsrfToken %>">
<script src="/js/toasts.js" defer></script>
</head>

<body class="bg-light">
<%- include('../partials/toasts') %>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5">

            <div class="card shadow-sm">
                <div class="card-body p-4">

                    <h2 class="text-center mb-4">
                        Вход в EuroMarket
                    </h2>

                    <form action="/login" method="POST">
        <input type="hidden" name="_csrf" value="<%= favoritesCsrfToken %>">

                        <div class="mb-3">
                            <label class="form-label">
                                Email
                            </label>

                            <input
                                type="email"
                                name="email"
                                class="form-control"
                                autocomplete="email"
                                required>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">
                                Пароль
                            </label>

                            <input
                                type="password"
                                name="password"
                                class="form-control"
                                autocomplete="current-password"
                                required>
                        </div>

                        <button
                            type="submit"
                            class="btn btn-primary w-100">
                            Войти
                        </button>

                    </form>

                    <p class="text-center mt-3 mb-0">
                        Нет аккаунта?
                        <a href="/register">
                            Зарегистрироваться
                        </a>
                    </p>

                    <div class="text-center mt-3">
                        <a href="/">На главную</a>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>

</body>
</html>
