<!DOCTYPE html>
<html lang="ru">
<head><%- include('../partials/head', { pageTitle: 'Мои объявления' }) %></head>
<body class="bg-light">
<%- include('../partials/toasts') %>
<%- include('../partials/header') %>
<div class="container py-4 account-layout">
    <%- include('../partials/account-nav', { activeAccountPage: '/my-listings' }) %>
    <main class="account-content">
            <!-- Объявления пользователя -->
            <section aria-label="Объявления">

                <div class="d-flex justify-content-between
                            align-items-center flex-wrap gap-3 mb-4">

                    <div>
                        <h3 class="mb-1">Мои объявления</h3>
                        <p class="text-muted mb-0">
                            Управление вашими объявлениями
                        </p>
                    </div>

                    <a href="/listings/create"
                    class="btn btn-primary">
                        + Подать объявление
                    </a>

                </div>

                <nav aria-label="Статус объявления" class="nav nav-pills flex-wrap gap-1 mb-3">
    <% for (const [value, label] of Object.entries(tabs)) { %>
        <a class="nav-link <%= status === value ? 'active' : '' %>" aria-current="<%= status === value ? 'page' : 'false' %>"
           href="<%= pageUrl({status:value,page:1}) %>"><%= label %></a>
    <% } %>
</nav>
<form class="row g-2 mb-4" action="/my-listings" method="get">
    <input type="hidden" name="status" value="<%= status %>">
    <div class="col-sm"><label for="own-search" class="form-label">Поиск</label>
        <input class="form-control" id="own-search" name="q" type="search" maxlength="100" value="<%= q %>"></div>
    <div class="col-sm"><label for="own-sort" class="form-label">Сортировка</label>
        <select id="own-sort" name="sort" class="form-select">
            <% for (const [value, label] of Object.entries(sorts)) { %>
                <option value="<%= value %>" <%= value === sort ? 'selected' : '' %>><%= label %></option>
            <% } %>
        </select></div>
    <div class="col-sm-auto align-self-end"><button class="btn btn-outline-primary">Применить</button></div>
</form>
<% if (listings.length === 0) { %>

                    <div class="card">
                        <div class="card-body text-center py-5">

                            <h5>Объявления не найдены</h5>

                            <p class="text-muted">
                                Выберите другую вкладку или измените запрос.
                            </p>

                            <a href="/listings/create"
                            class="btn btn-primary">
                                Создать объявление
                            </a>

                        </div>
                    </div>

                <% } else { %>

                    <div class="row g-3">

                        <% listings.forEach(listing => { %>

                            <div class="col-md-6 col-lg-4">

                                <div class="card h-100">

                                    <a href="/listings/<%= listing.id %>"
                                    class="listing-card-image">

                                        <% if (listing.main_image) { %>

                                            <img
                                                src="<%= listing.main_image %>"
                                                alt="<%= listing.title %>"
                                                loading="lazy"
                                            >

                                        <% } else { %>

                                            <div class="listing-no-image">
                                                <span>Нет фотографии</span>
                                            </div>

                                        <% } %>

                                    </a>

                                    <div class="card-body">

                                        <h5 class="card-title">
                                            <a href="/listings/<%= listing.id %>"
                                            class="text-decoration-none">
                                                <%= listing.title %>
                                            </a>
                                        </h5>

                                        <p class="text-muted mb-2">
                                            <%= listing.category_name %>
                                        </p>

                                        <h4 class="text-primary">
                                            <%= listing.price %>
                                            <%= listing.currency %>
                                        </h4>

                                        <div class="mt-3">

                                            <% if (listing.status === 'active') { %>

                                                <span class="badge bg-success">
                                                    Активное
                                                </span>

                                            <% } else if (listing.status === 'draft') { %>

                                                <span class="badge bg-warning text-dark">
                                                    Черновик
                                                </span>

                                            <% } else if (listing.status === 'pending_review') { %>
                                                <span class="badge bg-warning text-dark">На модерации</span>
                                            <% } else if (listing.status === 'rejected') { %>
                                                <span class="badge bg-danger">Отклонено</span>
                                                <p class="text-danger mt-2 mb-1"><%= listing.review_reason %></p>
                                            <% } else if (listing.status === 'sold') { %>

                                                <span class="badge bg-secondary">
                                                    Продано
                                                </span>

                                            <% } else { %>

                                                <span class="badge bg-light text-dark">
                                                    В архиве
                                                </span>

                                            <% } %>
                                            <%- include('../partials/seller-metrics', { metrics: listing, summary: false }) %>
                                            <% if (['draft', 'active', 'pending_review', 'rejected'].includes(listing.status)) { %>
                                                <a href="/listings/<%= listing.id %>/edit"
                                                class="btn btn-outline-primary btn-sm mt-3">
                                                    Редактировать
                                                </a>
                                            <% } %>

<% if (listing.moderation_locked) { %>
    <p class="alert alert-danger mt-2">Публикация ограничена: <%= listing.moderation_reason %></p>
<% } %>
<% if (['draft','rejected'].includes(listing.status) && !listing.moderation_locked) { %>

    <form
        action="/listings/<%= listing.id %>/publish"
        method="POST"
        class="mt-2"
    >
        <input type="hidden" name="_csrf" value="<%= favoritesCsrfToken %>">
        <button
            type="submit"
            class="btn btn-success w-100 listing-publish-btn"
        >
            <i class="bi bi-check-circle me-1"></i>
            <%= listing.status === 'rejected' ? 'Отправить повторно' : 'Отправить на проверку' %>
        </button>
    </form>

<% } %>

<% if (listing.status === 'active') { %>
    <form
        action="/listings/<%= listing.id %>/unpublish"
        method="POST"
        class="mt-2"
        data-confirm="Снять объявление с публикации?"
    >
        <input type="hidden" name="_csrf" value="<%= favoritesCsrfToken %>">
        <button
            type="submit"
            class="btn btn-outline-warning w-100 listing-unpublish-btn"
        >
            <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
            >
                <circle cx="12" cy="12" r="10"/>
                <path d="M4.9 4.9l14.2 14.2"/>
            </svg>
            Снять с публикации
        </button>
    </form>
<% } %>

<% if (listing.status === 'active') { %>
    <form
        action="/listings/<%= listing.id %>/sold"
        method="POST"
        class="mt-2"
        data-confirm="Отметить объявление как проданное?"
    >
        <input type="hidden" name="_csrf" value="<%= favoritesCsrfToken %>">
        <button
            type="submit"
            class="btn btn-outline-success w-100 listing-sold-btn"
        >
            <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
            >
                <circle cx="12" cy="12" r="10"/>
                <path d="m8 12 3 3 5-6"/>
            </svg>
            Продано
        </button>
    </form>
<% } %>

                                        </div>

                                        <p class="text-muted small mt-3 mb-0">
                                            Создано:
                                            <%= new Date(listing.created_at)
                                                .toLocaleDateString('ru-RU') %>
                                        </p>

                                    </div>

                                </div>

                            </div>

                        <% }) %>

                    </div>

                <% } %>

                <%- include('../partials/account-pagination', { page, totalPages, linkTo: value => pageUrl({page:value}) }) %>
</section>
    </main>
</div>
</body>
</html>
