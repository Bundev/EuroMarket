
<!DOCTYPE html>
<html lang="ru">

<head>
    <%- include('../partials/head', {
        pageTitle: 'Редактирование объявления'
    }) %>
    <link
    href="https://cdn.jsdelivr.net/npm/tom-select@2.4.3/dist/css/tom-select.bootstrap5.min.css"
    rel="stylesheet"
>
</head>

<body>
<%- include('../partials/toasts') %>

<%- include('../partials/header') %>
<% if (['active', 'pending_review'].includes(listing.status)) { %>
    <div class="container mt-3"><p class="alert alert-info mb-0">Изменения текста, цены, местоположения и фотографий отправляются на проверку. До одобрения объявление скрыто для покупателей.</p></div>
<% } %>

<main class="container py-4">

    <div class="row justify-content-center">
        <div class="col-lg-12 col-xl-10">

            <div class="d-flex justify-content-between
                        align-items-center mb-4">

                <h2 class="mb-0">
                    Редактирование объявления
                </h2>

                <a href="/listings/<%= listing.id %>"
                   class="btn btn-outline-secondary">
                    Назад
                </a>

            </div>

            <% if (error) { %>
                <div class="alert alert-danger">
                    <%= error %>
                </div>
            <% } %>

            <div class="card">
                <div class="card-body">
                        <!-- Фотографии объявления -->
                        <div class="mb-4">

                            <label class="form-label">
                                Фотографии объявления
                            </label>

                            <% if (images.length > 0) { %>

                                <div class="row g-3">

                                    <% images.forEach(image => { %>

                                        <div class="col-6 col-md-3">


                                            <div class="listing-edit-image">

                                                <img
                                                    src="<%= image.image_path %>"
                                                    alt="Фотография объявления"
                                                    loading="lazy"
                                                >

                                                <form
                                                    action="/listings/<%= listing.id %>/images/<%= image.id %>/delete"
                                                    method="POST"
                                                    class="listing-image-delete-form"
                                                    data-confirm="Удалить фотографию?"
                                                >
                                                    <button
                                                        type="submit"
                                                        class="listing-image-delete"
                                                        title="Удалить фотографию"
                                                        aria-label="Удалить фотографию"
                                                    >
                                                        <svg
                                                            xmlns="http://www.w3.org/2000/svg"
                                                            width="18"
                                                            height="18"
                                                            viewBox="0 0 24 24"
                                                            fill="none"
                                                            stroke="currentColor"
                                                            stroke-width="2"
                                                            stroke-linecap="round"
                                                            stroke-linejoin="round"
                                                            aria-hidden="true"
                                                        >
                                                            <path d="M3 6h18"/>
                                                            <path d="M8 6V4h8v2"/>
                                                            <path d="M19 6l-1 14H6L5 6"/>
                                                            <path d="M10 10v7"/>
                                                            <path d="M14 10v7"/>
                                                        </svg>
                                                    </button>
                                                <input type="hidden" name="_csrf" value="<%= favoritesCsrfToken %>">
                                                </form>

                                            </div>


                                            

                                        </div>

                                    <% }) %>

                                </div>

                            <% } else { %>

                                <p class="text-muted">
                                    У объявления пока нет фотографий.
                                </p>

                            <% } %>

                        </div>

                        <!-- Загрузка новых фотографий -->
                        <form
                            action="/listings/<%= listing.id %>/images"
                            method="POST"
                            enctype="multipart/form-data" data-listing-upload
                            class="listing-upload-form mb-4"
                            id="listingUploadForm"
                            data-existing-count="<%= images.length %>"
                        >
                            <noscript><p class="text-danger">Для безопасной отправки этой формы включите JavaScript.</p></noscript>
                            <h5 class="mb-3">Добавить фотографии</h5>

                            <div class="listing-upload-zone" id="listingUploadZone"
                                role="button" tabindex="0"
                                aria-label="Выбрать фотографии">

                                <div class="listing-upload-icon">
                                    <svg width="32" height="32"
                                        viewBox="0 0 24 24" fill="none"
                                        stroke="currentColor" stroke-width="1.8"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        aria-hidden="true">
                                        <path d="M12 16V4"/>
                                        <path d="m7 9 5-5 5 5"/>
                                        <path d="M20 16.6A5 5 0 0 0 18 7a6 6 0 0 0-11.5 1.5A4.5 4.5 0 0 0 7 17h2"/>
                                    </svg>
                                </div>

                                <div class="fw-semibold mt-3">
                                    Перетащите фотографии сюда
                                </div>

                                <div class="text-muted small mt-1">
                                    или нажмите, чтобы выбрать файлы
                                </div>

                                <div class="listing-upload-hint mt-3">
                                    JPG, PNG, WebP · до 5 МБ
                                </div>
                            </div>

                            <input
                                type="file"
                                name="images"
                                id="newListingImages"
                                accept="image/jpeg,image/png,image/webp"
                                multiple
                                class="visually-hidden"
                                tabindex="-1"
                                required
                            >

                            <div id="newImagesPreview"
                                class="row g-2 mt-2"></div>

                            <div class="d-flex justify-content-between
                                        align-items-center mt-3 mb-3">
                                <small class="text-muted">
                                    До 10 фотографий на объявление
                                </small>
                                <small class="text-muted" id="uploadCount">
                                    0 выбрано
                                </small>
                            </div>

                            <button
                                type="submit"
                                class="btn btn-primary w-100 listing-upload-button"
                                id="uploadImagesButton"
                                disabled
                            >
                                Загрузить фотографии
                            </button>
                        </form>


                    <form
                        action="/listings/<%= listing.id %>/edit"
                        method="POST"
                    >

                        <!-- Название -->
                        <div class="mb-3">

                            <label class="form-label">
                                Название объявления
                            </label>

                            <input
                                type="text"
                                name="title"
                                class="form-control"
                                value="<%= listing.title %>"
                                maxlength="200"
                                required
                            >

                        </div>

                        <!-- Категория -->
                        <div class="mb-3">

                            <label class="form-label">
                                Категория
                            </label>

                            <select
                                name="category_id"
                                class="form-select"
                                required
                            >

                                <% categories.forEach(category => { %>

                                    <option
                                        value="<%= category.id %>"
                                        <%= Number(category.id) === Number(listing.category_id) ? 'selected' : '' %>
                                    >
                                        <%= category.name %>
                                    </option>

                                <% }) %>

                            </select>

                        </div>

<div class="mb-3">
    <label for="countrySelect" class="form-label">
        Страна
    </label>

    <select
        name="country_id"
        id="countrySelect"
        class="form-select"
        required
    >
        <% countries.forEach(country => { %>
            <option
                value="<%= country.id %>"
                data-currency="<%= country.currency %>"
                <%= Number(listing.country_id) === Number(country.id)
                    ? 'selected'
                    : '' %>
            >
                <%= country.name %>
            </option>
        <% }) %>
    </select>
</div>

<div class="mb-3">
    <label for="citySelect" class="form-label">
        Город
    </label>

    <select
        name="city_id"
        id="citySelect"
        class="form-select"
        data-selected-city="<%= listing.city_id || '' %>"
    >
        <option value="">Загрузка городов...</option>
    </select>
</div>

                        <!-- Цена -->
                        <div class="mb-3">

                            <label class="form-label">
                                Цена <span id="priceCurrency">(<%= listing.currency %>)</span>
                            </label>

                            <input
                                type="number"
                                name="price"
                                class="form-control"
                                value="<%= listing.price %>"
                                min="0"
                                max="9999999999.99"
                                step="0.01"
                                required
                            >

                        </div>

                        <p class="form-text" id="countryPriceWarning" role="status">
                            При смене страны проверьте и при необходимости измените цену. Сумма автоматически не пересчитывается.
                        </p>

                        <!-- Описание -->
                        <div class="mb-4">

                            <label class="form-label" for="item-condition">Состояние товара</label>
                            <input class="form-control mb-3" id="item-condition" name="item_condition" maxlength="80" value="<%= listing.item_condition || '' %>">
                            <label class="form-label" for="listing-description">Описание и характеристики</label>
                            <textarea
                                id="listing-description"
                                name="description"
                                class="form-control"
                                rows="7"
                                required
                            ><%= listing.description %></textarea>
                            <label for="bargaining-enabled" class="form-label mt-3">Разрешить торг</label>
                            <select id="bargaining-enabled" name="bargaining_enabled" class="form-select" aria-describedby="bargaining-help">
                                <option value="0" <%= listing.bargaining_enabled ? '' : 'selected' %>>Нет</option>
                                <option value="1" <%= listing.bargaining_enabled ? 'selected' : '' %>>Да</option>
                            </select>
                            <p id="bargaining-help" class="form-text mb-0">После сохранения покупатели увидят кнопку торга, когда модератор одобрит объявление.</p>

                        </div>

                        

                        <div class="d-flex gap-2">

                            <button
                                type="submit"
                                class="btn btn-primary"
                            >
                                Сохранить изменения
                            </button>

                            <a
                                href="/listings/<%= listing.id %>"
                                class="btn btn-outline-secondary"
                            >
                                Отмена
                            </a>

                        </div>

                    <input type="hidden" name="_csrf" value="<%= favoritesCsrfToken %>">
                    </form>

                </div>
            </div>

        </div>
    </div>

</main>

<script src="/js/listing-edit-photos.js"></script>
<script src="https://cdn.jsdelivr.net/npm/tom-select@2.4.3/dist/js/tom-select.complete.min.js"></script>

<script src="/js/listing-edit-location.js"></script>

<script src="/js/listing-upload.js" defer></script>
</body>
</html>
