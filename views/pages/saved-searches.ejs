<!DOCTYPE html>
<html lang="ru">
<head><%- include('../partials/head', { pageTitle: 'Сохранённые поиски' }) %></head>
<body>
<%- include('../partials/toasts') %>
<%- include('../partials/header') %>
<div class="container py-4 account-layout">
    <%- include('../partials/account-nav', { activeAccountPage: '/saved-searches' }) %>
    <main class="account-content">
        <h1 class="h3 mb-3">Сохранённые поиски</h1>
        <% if (!searches) { %>
            <form class="card card-body" method="post" action="/saved-searches">
                <h2 class="h5">Сохранить поиск</h2>
                <p><a href="<%= pendingUrl %>">Посмотреть выбранные фильтры</a></p>
                <input type="hidden" name="_csrf" value="<%= favoritesCsrfToken %>">
                <%- include('../partials/saved-search-fields', { fields: pendingFields }) %>
                <label class="form-label" for="pending-search-name">Название поиска</label>
                <input class="form-control mb-3" id="pending-search-name" name="name" value="<%= pendingName %>" maxlength="100" required>
                <div><button class="btn btn-primary" type="submit">Сохранить поиск</button></div>
            </form>
        <% } else if (!searches.length) { %>
            <p>Выберите фильтры в каталоге и сохраните поиск.</p>
            <a class="btn btn-primary" href="/search">Открыть поиск</a>
        <% } else { %>
            <% for (const search of searches) {
                const location = [search.countryName, search.cityName].filter(Boolean).join(', ');
                const price = [search.minPrice != null && 'от ' + Number(search.minPrice).toLocaleString('ru-RU'),
                    search.maxPrice != null && 'до ' + Number(search.maxPrice).toLocaleString('ru-RU'), search.currency].filter(Boolean).join(' ');
                const filters = [search.search && '«' + search.search + '»', location, search.categoryName, price].filter(Boolean);
            %>
                <article class="card card-body mb-3" aria-labelledby="saved-title-<%= search.id %>">
                    <h2 class="h5" id="saved-title-<%= search.id %>"><%= search.name %></h2>
                    <p class="text-muted"><%= filters.length ? filters.join(' · ') : 'Все объявления' %></p>
                    <p><a href="/saved-searches/<%= search.id %>/open">Открыть поиск</a></p>
                    <form method="post" action="/saved-searches/<%= search.id %>">
                        <input type="hidden" name="_csrf" value="<%= favoritesCsrfToken %>">
                        <label class="form-label" for="saved-name-<%= search.id %>">Название поиска</label>
                        <input class="form-control mb-3" id="saved-name-<%= search.id %>" name="name" value="<%= search.name %>" maxlength="100" required>
                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input" type="checkbox" role="switch" id="saved-notify-<%= search.id %>" name="notify" value="1" <%= search.notify ? 'checked' : '' %>>
                            <label class="form-check-label" for="saved-notify-<%= search.id %>">Уведомлять о новых объявлениях</label>
                        </div>
                        <div class="d-flex flex-wrap gap-2">
                            <button class="btn btn-outline-primary" type="submit" name="intent" value="update">Сохранить изменения</button>
                            <button class="btn btn-outline-danger" type="submit" name="intent" value="delete" formnovalidate>Удалить поиск</button>
                        </div>
                    </form>
                </article>
            <% } %>
        <% } %>
    </main>
</div>
</body>
</html>
