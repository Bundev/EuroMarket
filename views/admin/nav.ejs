<nav class="nav nav-pills flex-wrap gap-2 mb-4" aria-label="Административная навигация">
    <% for (const [path, title] of [['dashboard','Обзор'],['users','Пользователи'],['listings','Объявления'],['moderation','Модерация'],['reports','Жалобы'],['disputes','Споры'],['reviews','Отзывы'],['logs','Журнал']]) { %>
        <a href="<%= path === 'dashboard' ? '/admin' : '/admin/' + path %>" class="nav-link <%= section === path ? 'active' : '' %>">
            <%= title %><% if (path === 'moderation') { %> <span class="badge bg-secondary" aria-label="На проверке"><%= typeof pendingModerationCount === 'undefined' ? 0 : pendingModerationCount %></span><% } %>
            <% if (path === 'disputes') { %><span class="badge bg-secondary" data-open-disputes><%= typeof openDisputeCount === 'undefined' ? 0 : openDisputeCount %><span class="visually-hidden"> открыто</span></span><% } %>
        </a>
    <% } %>
</nav>
